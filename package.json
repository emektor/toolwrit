{
  "name": "toolwrit",
  "version": "0.1.0",
  "description": "A written authority for AI agents. Allowlist the tools, cap the budget, prove what happened.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emektor/toolwrit.git"
  },
  "homepage": "https://github.com/emektor/toolwrit#readme",
  "bugs": {
    "url": "https://github.com/emektor/toolwrit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "toolwrit": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/adapters/sdk.js",
    "./mcp": "./dist/adapters/mcp-proxy.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "guardrails",
    "mcp",
    "tool-calling",
    "policy",
    "audit",
    "llm",
    "security"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
